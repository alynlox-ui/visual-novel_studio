{
  "name": "visual-novel-game-player",
  "version": "1.0.0",
  "description": "Portable Windows player for Visual Novel Studio exports",
  "main": "main.js",
  "scripts": {
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^37.4.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.alynlox.visualnovel.player",
    "productName": "Visual Novel Player",
    "artifactName": "visual-novel-player.exe",
    "files": ["main.js", "default-game.html", "package.json"],
    "asar": true,
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    }
  }
}
